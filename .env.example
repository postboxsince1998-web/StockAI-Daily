# StockAI Daily Environment Configuration
PORT=5050
DATA_MODE=free

# Database Configuration:
# Leave empty for local SQLite database (default)
# For Cloud Deployment, add your FREE Supabase/Neon PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Optional AI API Key (If omitted, StockAI Daily uses its built-in free Financial Teacher AI Engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
