{
  "name": "stock-ai-daily",
  "version": "1.0.0",
  "description": "Understand What Changed Today - Beginner-friendly Indian stock-market daily analysis app",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "seed": "node backend/database/seed.js",
    "daily-analysis": "node backend/scripts/runDailyAnalysis.js",
    "update-prices": "node backend/scripts/updatePrices.js",
    "update-news": "node backend/scripts/updateNews.js",
    "update-fundamentals": "node backend/scripts/updateFundamentals.js",
    "migrate-cloud": "node backend/database/migrateToCloud.js",
    "build:frontend": "vite build --outDir dist",

    "dev": "concurrently \"node backend/server.js\" \"vite\""
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "rss-parser": "^3.13.0",
    "yahoo-finance2": "^2.13.3"
  },

  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  }
}
